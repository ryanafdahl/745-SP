+++ b/JetlinkKit/Tests/JetlinkServerTests/TensorManifestTests.swift
@@ -0,0 +1,24 @@
+import Foundation
+import Testing
+@testable import JetlinkLiteRT
+
+struct TensorManifestTests {
+  let source = String(repeating: "a", count: 64)
+  func data(_ changes: [String: String] = [:]) throws -> Data {
+    var manifest = ["source_sha256": source, "compiled_sha256": String(repeating: "b", count: 64),
+                    "soc": "Tensor_G6", "litert": "2.2.0"]
+    manifest.merge(changes) { _, new in new }
+    return try JSONSerialization.data(withJSONObject: manifest)
+  }
+  @Test func acceptsMatchingModel() throws {
+    #expect(try TensorManifest.read(data(), source: source, chip: "Tensor G6").soc == "Tensor_G6")
+  }
+  @Test(arguments: ["source_sha256", "compiled_sha256", "soc", "litert"])
+  func rejectsMismatch(_ key: String) throws {
+    let invalid = try data([key: "wrong"])
+    #expect(throws: (any Error).self) { try TensorManifest.read(invalid, source: source, chip: "Tensor G6") }
+  }
+  @Test func rejectsMissingManifestFields() {
+    #expect(throws: (any Error).self) { try TensorManifest.read(Data("{}".utf8), source: source, chip: "Tensor G6") }
+  }
+}
